{
  "name": "sati-ui",
  "version": "0.1.10",
  "private": true,
  "description": "Sati Web UI — talks to src/gateway via ui/server/sati-bridge.js.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check:runtime": "node ../scripts/check-node-runtime.mjs",
    "predev": "npm run check:runtime && node ../scripts/bootstrap-sati-config.mjs && pnpm --filter edgeclaw-memory-core build",
    "dev": "node ../scripts/dev-launcher.mjs",
    "dev:concurrent": "concurrently --kill-others-on-fail --names gateway,server,client \"npm:dev:gateway\" \"npm:dev:server\" \"npm:dev:client\"",
    "dev:gateway": "npm --prefix .. run --ignore-scripts server",
    "dev:server": "npm run check:runtime && node --import tsx server/index.js",
    "dev:client": "vite",
    "server": "npm run check:runtime && node --import tsx server/index.js",
    "preserver": "pnpm --filter edgeclaw-memory-core build",
    "gateway": "npm --prefix .. run server",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/ server/ --max-warnings 0 && node ../scripts/check-ui-server-boundary.mjs",
    "lint:fix": "eslint src/ server/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "npm run build && npm run start:built",
    "start:built": "concurrently --kill-others-on-fail --names gateway,server \"npm:gateway\" \"npm:server\"",
    "postinstall": "node scripts/fix-node-pty.js"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "1.2.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.43.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@octokit/rest": "^22.0.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@replit/codemirror-minimap": "^0.5.2",
    "@tailwindcss/typography": "^0.5.20",
    "@uiw/react-codemirror": "^4.25.11",
    "@univerjs/core": "0.25.1",
    "@univerjs/design": "0.25.1",
    "@univerjs/docs": "0.25.1",
    "@univerjs/docs-ui": "0.25.1",
    "@univerjs/engine-formula": "0.25.1",
    "@univerjs/engine-render": "0.25.1",
    "@univerjs/sheets": "0.25.1",
    "@univerjs/sheets-formula": "0.25.1",
    "@univerjs/sheets-formula-ui": "0.25.1",
    "@univerjs/sheets-numfmt": "0.25.1",
    "@univerjs/sheets-numfmt-ui": "0.25.1",
    "@univerjs/sheets-ui": "0.25.1",
    "@univerjs/ui": "0.25.1",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.2",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.3",
    "docx-preview": "0.4.0",
    "edgeclaw-memory-core": "workspace:*",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "html2canvas": "1.4.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.31.0",
    "mime-types": "^3.0.1",
    "multer": "^2.2.0",
    "node-pty": "^1.1.0-beta34",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.0",
    "react-error-boundary": "^6.1.2",
    "react-i18next": "^17.0.12",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "shell-quote": "^1.10.0",
    "tailwind-merge": "^3.3.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.3",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "jsdom": "^29.0.2",
    "node-gyp": "^12.3.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
