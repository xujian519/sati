{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    // "checkJs": true,
    "types": ["vite/client"],
    // Pin react/react-dom type resolution to the UI's React 19 typings.
    // Without this, libraries under node_modules/.pnpm resolve "react"
    // to the root workspace's React 19 (@types/react@19), producing
    // TS2786 ReactNode mismatches (bigint not assignable).
    "paths": {
      "@sati/web-client": ["../src/web/client/index.ts"],
      "@sati/web-client/*": ["../src/web/client/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src", "shared", "vite.config.js"]
}
