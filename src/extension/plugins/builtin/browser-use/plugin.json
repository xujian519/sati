{
  "name": "browser-use",
  "version": "1.0.0",
  "description": "Browser automation powered by @playwright/mcp (Microsoft)",
  "mcpServers": {
    "browser-use": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp", "--browser", "chromium", "--allow-unrestricted-file-access"],
      "perSession": true
    }
  }
}
