{
  "compilerOptions": {
    "target": "ES2022",
    // TS 7 移除 node10 解析，故用 node16：相对导入须带 .js 扩展名；
    // src/ 下 package.json 显式 type:commonjs，产物保持 CJS 语义
    // （Electron main/preload 加载方式不变），根 dist 跨树编译同此判型。
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "electron"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "dist-electron"]
}
