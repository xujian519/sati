{
  "name": "sati",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "ui",
    "src/context/memory/edgeclaw-memory-core"
  ],
  "bin": {
    "sati": "./dist/src/cli/sati.js"
  },
  "scripts": {
    "check:runtime": "node scripts/check-node-runtime.mjs",
    "install:browser": "npx @playwright/mcp install-browser chrome-for-testing",
    "prebuild": "npm run check:runtime && node scripts/bootstrap-sati-config.mjs && pnpm --filter edgeclaw-memory-core build",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/extension/plugins/builtin','dist/src/extension/plugins/builtin',{recursive:true})\" && node -e \"require('fs').cpSync('src/knowledge/patent/ipc-standards.yaml','dist/src/knowledge/patent/ipc-standards.yaml')\" && node -e \"require('fs').cpSync('src/knowledge/patent/wiki','dist/src/knowledge/patent/wiki',{recursive:true})\"",
    "server": "npm run check:runtime && tsx src/cli/sati.ts server",
    "server:built": "npm run check:runtime && node dist/src/cli/sati.js server",
    "skills:migrate": "tsx src/cli/sati.ts skills migrate",
    "predev": "npm run check:runtime && node scripts/bootstrap-sati-config.mjs",
    "dev": "node scripts/dev-launcher.mjs",
    "test": "npm run build && node --test --test-force-exit --test-timeout 60000 \"dist/tests/**/*.test.js\" \"dist/tests/**/*.spec.js\"",
    "e2e:real-agent-lifecycle-hooks": "npm run build && SATI_RUN_REAL_AGENT_LIFECYCLE_E2E=1 node dist/tests/agent/e2e/run-real-agent-lifecycle-hooks.js",
    "typecheck": "tsc --noEmit && pnpm --filter edgeclaw-memory-core typecheck",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src tests scripts --fix",
    "format": "biome format --write .",
    "format:check": "biome check .",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@eslint/js": "^9.39.3",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.14",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.3",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^17.3.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "node scripts/check-commit-msg.mjs \"$1\""
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json}": "node scripts/lint-staged.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@larksuiteoapi/node-sdk": "^1.65.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vscode/ripgrep": "^1.18.0",
    "csv-parse": "^7.0.0",
    "edgeclaw-memory-core": "workspace:*",
    "ink": "^7.0.2",
    "ink-text-input": "^6.0.0",
    "js-tiktoken": "^1.0.21",
    "jsonrepair": "^3.14.0",
    "mupdf": "^1.27.0",
    "parse5": "^8.0.1",
    "react": "^19.2.6",
    "sharp": "^0.34.5",
    "slice-ansi": "^9.0.0",
    "string-width": "^8.2.1",
    "turndown": "^7.2.4",
    "undici": "^8.2.0",
    "weixin-ilink": "^0.1.0",
    "ws": "^8.21.0",
    "yaml": "^2.8.4"
  },
  "packageManager": "pnpm@10.32.1"
}
